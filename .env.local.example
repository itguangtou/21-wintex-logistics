# 复制本文件为 .env.local，填入真实值。切勿提交到 Git。

# ① 项目地址（首页 Copy → Project URL）
NEXT_PUBLIC_SUPABASE_URL=https://dlhhwuuvndwqkkppohie.supabase.co

# ② 公开密钥（Publishable key，sb_publishable_ 开头）
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_替换成你的

# ③ 私密密钥（Secret key，API Keys 页面点眼睛后复制，sb_secret_ 开头）
SUPABASE_SERVICE_ROLE_KEY=sb_secret_替换成你的

# ④ 数据库直连（首页 Copy → Direct connection string）
# 把 [YOUR-PASSWORD] 换成创建项目时 Generate 的数据库密码
DATABASE_URL=postgresql://postgres:你的数据库密码@db.dlhhwuuvndwqkkppohie.supabase.co:5432/postgres

# 管理端（后续用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成你的强密码
ADMIN_SESSION_SECRET=改成随机长字符串

NEXT_PUBLIC_SITE_URL=http://localhost:3000
